{
    "name": "sitc/clientq",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "admin/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClientQ\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --no-progress --testsuite Unit",
        "test:integration": [
            "docker compose up -d --build app",
            "docker compose exec -T -e CLIENTQ_RUN_INTEGRATION_TESTS=1 app vendor/bin/phpunit --no-progress --testsuite Integration"
        ],
        "analyze": "phpstan analyze admin api platform-admin lib account .",
        "quality": [
            "@analyze",
            "@test"
        ],
        "build": [
            "echo 'Starting production build preparation...'",
            "@quality",
            "composer install --no-dev --optimize-autoloader --no-interaction",
            "echo 'Build ready for deployment!'"
        ]
    }
}
