# Disable directory listing
Options -Indexes

# Enable rewrite engine
RewriteEngine On

# Redirect .php URLs to clean admin URLs
RewriteCond %{THE_REQUEST} \s/+admin/[^?\s]+\.php[\s?] [NC]
RewriteRule ^(.+)\.php$ /admin/$1 [R=301,L,NE]

# Remove .php extension for admin pages
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

# Block direct access to auth and layout files
<Files "auth.php">
    Require all denied
</Files>
<Files "layout.php">
    Require all denied
</Files>
