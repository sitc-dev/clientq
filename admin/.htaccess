# Disable directory listing
Options -Indexes

# Enable rewrite engine
RewriteEngine On

# Remove .php extension for admin pages
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

# Redirect .php URLs to clean URLs
RewriteCond %{THE_REQUEST} /([^.]+)\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# Block direct access to auth and layout files
<Files "auth.php">
    Require all denied
</Files>
<Files "layout.php">
    Require all denied
</Files>
